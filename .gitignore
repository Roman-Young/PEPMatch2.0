.~*
*.db
*.pepidx
*.pepidx.chunk_*
*.pickle
*.pkl
*.pyc
*.so
.DS_Store
__pycache__/
_Inline/
benchmarking/methods/__pycache__
bin/
build/
data/
dist/
notebooks/
old_code/
pepmatch.egg-info/
pepmatch/__pycache__
pepmatch/rs-engine/target/
proteomes/*.pdb
proteomes/*.phr
proteomes/*.pin
proteomes/*.pot
proteomes/*.psq
proteomes/*.ptf
proteomes/*.pto
proteomes/*.pickle
benchmarking.xlsx
# All generated benchmark output lands in benchmarking/results/; everything in there is
# reproducible from a run, so ignore the whole directory but keep the folder itself.
benchmarking/results/*
!benchmarking/results/.gitkeep
benchmarking/*.log
# Synthetic indel benchmark: the small subsets ARE committed -- they are what a reviewer
# can re-run cheaply. The 100k/1M artifacts are hundreds of MB and fully reproducible
# from the generator plus the seed and proteome sha256 recorded in
# expected/synth-*-manifest.json. Regenerate with slurm/run-synth-generate.sbatch.
benchmarking/queries/synth-*-10k.fasta
benchmarking/queries/synth-*-100k.fasta
benchmarking/queries/synth-*-1m.fasta
benchmarking/expected/synth-*-10k-expected.tsv
benchmarking/expected/synth-*-100k-expected.tsv
benchmarking/expected/synth-*-1m-expected.tsv
benchmarking/expected/synth-*-rejected.tsv
# Scratch prefixes from local pipeline tests (--out-prefix synth-1indel-fixtest etc.)
benchmarking/queries/synth-*-fixtest-*
benchmarking/expected/synth-*-fixtest-*
notes.txt
pepmatch.py
test.csv
wheelhouse/

# keep test data
!pepmatch/tests/data/
